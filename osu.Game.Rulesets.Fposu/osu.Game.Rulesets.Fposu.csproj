<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>osu! in first person, for aim training. Based on McOsu's FPoSu.</Description>
  </PropertyGroup>

  <PropertyGroup Label="Nuget">
    <Title>osu!fps (ruleset)</Title>
    <PackageId>osu.Game.Rulesets.Fposu</PackageId>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Label="Client References" Condition="'$(BuildAgainstClient)' == 'true'">
    <ProjectReference Include="$(ClientDirectory)osu.Game\osu.Game.csproj" />
    <ProjectReference Include="$(ClientDirectory)osu.Game.Rulesets.Osu\osu.Game.Rulesets.Osu.csproj" />
  </ItemGroup>

  <ItemGroup Label="Package References" Condition="'$(BuildAgainstClient)' != 'true'">
    <PackageReference Include="ppy.osu.Game" Version="$(OsuVersion)" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Osu" Version="$(OsuVersion)" />
  </ItemGroup>
</Project>
